# Copy to grafana.env (chmod 600) or generate it from your gcx config with `make env`.
# Never commit grafana.env: it contains tokens.

# Comma-separated environment names; each name maps to GRAFANA_<PREFIX>_* variables,
# where PREFIX is the name uppercased with every non-alphanumeric character turned into `_`.
GRAFANA_ENVIRONMENTS=dev,prod

GRAFANA_DEV_URL=https://grafana.example.com
GRAFANA_DEV_TOKEN=glsa_xxx
# GRAFANA_DEV_ORG_ID=1

GRAFANA_PROD_URL=https://grafana.example.com
GRAFANA_PROD_TOKEN=glsa_xxx
# GRAFANA_PROD_ORG_ID=1

# Optional limits
# GRAFANA_GCX_TIMEOUT=60
# GRAFANA_MAX_CONCURRENCY=4
# GRAFANA_MAX_RESULT_CHARS=50000

# Optional: corporate VPN with an HTTP proxy (passed through to gcx)
# HTTPS_PROXY=http://proxy.example.com:3128
# NO_PROXY=localhost,127.0.0.1

# Compose-level settings are NOT read from grafana.env: put them in .env next to
# docker-compose.yml (compose reads it for ${...} interpolation) or export them in the shell.
#   GRAFANA_MCP_PORT=8004                                 host port (always 127.0.0.1)
#   GRAFANA_EXTRA_CA_FILE=/path/to/corporate-ca.pem       extra CA bundle, mounted read-only
